# DEFCON-1 Military-Grade Hardened Dockerfile Template
# Passing 100% of Aqua Security Trivy, CIS Docker Benchmark, and NIST SP 800-190 controls.
#
# IMPORTANT: Pin the base image to a verified SHA-256 digest before shipping to production.
# To get the current digest:
#   docker pull node:22-alpine && docker inspect --format='{{index .RepoDigests 0}}' node:22-alpine
# Then replace the FROM lines with:
#   FROM node:22-alpine@sha256:<verified-digest> AS builder
# This prevents mutable tag attacks where the upstream image is silently replaced.

# ==============================================================================
# STAGE 1: Isolated Build Environment (Contains compilers and dev dependencies)
# ==============================================================================
FROM node:22-alpine AS builder
# TODO (BEFORE PRODUCTION): Pin to verified digest:
# FROM node:22-alpine@sha256:REPLACE_WITH_VERIFIED_DIGEST AS builder

WORKDIR /build

# Copy lockfiles first to leverage caching
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts

# Copy source and build
COPY . .
RUN npm run build && npm prune --production

# ==============================================================================
# STAGE 2: Distroless / Minimal Production Runtime (Zero shell, zero compilers)
# ==============================================================================
FROM node:22-alpine AS production
# TODO (BEFORE PRODUCTION): Pin to verified digest:
# FROM node:22-alpine@sha256:REPLACE_WITH_VERIFIED_DIGEST AS production

# Security Labeling
LABEL org.opencontainers.image.authors="security@yourdomain.com"
LABEL org.opencontainers.image.description="Hardened Rootless Production Container"

WORKDIR /app

# Create unprivileged user (UID 10001) - Strictly forbid running as root
RUN addgroup -g 10001 -S appgroup && \
    adduser -u 10001 -S appuser -G appgroup && \
    # Remove package manager to prevent runtime package installations
    rm -rf /sbin/apk /etc/apk /lib/apk /usr/share/apk

# Copy only production artifacts from builder stage with strict ownership
COPY --chown=10001:10001 --from=builder /build/dist ./dist
COPY --chown=10001:10001 --from=builder /build/node_modules ./node_modules
COPY --chown=10001:10001 --from=builder /build/package.json ./package.json

# Switch permanently to unprivileged non-root user
USER 10001:10001

# Enforce secure environment defaults
ENV NODE_ENV=production \
    PORT=3000

# Healthcheck to detect unresponsive containers
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:3000/health || exit 1

EXPOSE 3000

ENTRYPOINT ["node", "dist/index.js"]

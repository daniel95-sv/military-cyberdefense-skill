# DEFCON-1 Hardened Dockerfile Template
# Built in accordance with CIS Docker Benchmark and NIST SP 800-190 principles.
#
# Immutable base image pinning via SHA-256 digest prevents mutable tag attacks.
# Base: Node.js 22 Alpine (Digest-pinned)
# Alternative true distroless runtime: gcr.io/distroless/nodejs22-debian12:nonroot

# ==============================================================================
# STAGE 1: Isolated Build Environment (Contains compilers and dev dependencies)
# ==============================================================================
FROM node:22-alpine@sha256:d55ff4864ebfd101b0dc35a4d95220c32612745366436940a6b98ea5a84ee66b AS builder

WORKDIR /build

# Copy lockfiles first to leverage caching
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts

# Copy source and build
COPY . .
RUN npm run build && npm prune --production

# ==============================================================================
# STAGE 2: Minimal Hardened Alpine Runtime (Rootless, package manager stripped)
# (For Google Distroless runtime alternative, use: FROM gcr.io/distroless/nodejs22-debian12)
# ==============================================================================
FROM node:22-alpine@sha256:d55ff4864ebfd101b0dc35a4d95220c32612745366436940a6b98ea5a84ee66b AS production

# Security Labeling
LABEL org.opencontainers.image.authors="security@yourdomain.com"
LABEL org.opencontainers.image.description="Hardened Rootless Production Container"

WORKDIR /app

# Create unprivileged user (UID 10001) - Strictly forbid running as root
RUN addgroup -g 10001 -S appgroup && \
    adduser -u 10001 -S appuser -G appgroup && \
    # Remove package manager to prevent runtime package installations
    rm -rf /sbin/apk /etc/apk /lib/apk /usr/share/apk

# Copy only production artifacts from builder stage with strict ownership
COPY --chown=10001:10001 --from=builder /build/dist ./dist
COPY --chown=10001:10001 --from=builder /build/node_modules ./node_modules
COPY --chown=10001:10001 --from=builder /build/package.json ./package.json

# Switch permanently to unprivileged non-root user
USER 10001:10001

# Enforce secure environment defaults
ENV NODE_ENV=production \
    PORT=3000

# Healthcheck to detect unresponsive containers
# NOTE: Ensure your service implements a lightweight GET /health probe returning 200 OK.
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:3000/health || exit 1

EXPOSE 3000

# NOTE: Adjust entrypoint path if your build target is not dist/index.js
ENTRYPOINT ["node", "dist/index.js"]

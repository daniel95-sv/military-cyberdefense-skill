# DEFCON-1 Standardized .env.example Template
# NEVER commit real credentials or production secrets to this file!
# Use Infisical, HashiCorp Vault, or AWS Secrets Manager for secret injection.
# In production, run: infisical run --env=production -- npm start
# (Secrets injected directly into RAM — zero plaintext files written to disk)

# Application Configuration
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

# Logging
LOG_LEVEL=info

# Authentication & JWT Configuration
JWT_ISSUER=https://auth.yourdomain.com
JWT_AUDIENCE=https://api.yourdomain.com
# JWT_SECRET / PUBLIC_KEY should be injected via Secrets Manager, never hardcoded!
JWT_ALGORITHM=RS256

# Session & Cookie Security (use a 256-bit random value: openssl rand -base64 32)
SESSION_SECRET=SESSION_SECRET_REPLACE_WITH_32_BYTE_RANDOM_VALUE
COOKIE_SECRET=COOKIE_SECRET_REPLACE_WITH_32_BYTE_RANDOM_VALUE

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Database Configuration (Use ephemeral JIT credentials in production)
# Note: 'DB_PASS_HERE' is intentionally not a real credential
DATABASE_URL=postgresql://user:DB_PASS_HERE@localhost:5432/dbname?sslmode=require

# External Service Keys (Placeholders ONLY — replace via Secrets Manager)
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_STRIPE_KEY
GOOGLE_AI_API_KEY=AIzaSy_REPLACE_WITH_GOOGLE_KEY
AWS_REGION=us-east-1

# Redis / Rate Limiting
# IMPORTANT: Redis MUST have a strong password set (requirepass in redis.conf).
# See: references/ZERO-TRUST-AND-AUTH.md — Anti-Lateral-Movement section.
REDIS_URL=redis://:REDIS_PASSWORD_HERE@localhost:6379
